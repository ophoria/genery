{
  "name": "genery-gallery",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others \"npm run server\" \"npm run client\"",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "server": "tsx server/index.ts",
    "start": "npm run dev",
    "generate-test-data": "tsx scripts/generate-test-images.ts",
    "client": "vite",
    "test:ai": "tsx --test scripts/ai.test.ts scripts/ai-ui.test.ts",
    "ai:smoke": "tsx scripts/ai-smoke.ts",
    "test:security": "tsx --test scripts/security.test.ts scripts/security-runtime.test.ts scripts/security-lifecycle.test.ts scripts/security-streams.test.ts scripts/security-work.test.ts scripts/connections.test.ts",
    "serve": "npm run build && npm run server"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "image-size": "^1.1.1",
    "lucide-react": "^0.395.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.33.4"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.15.7",
    "typescript": "^5.5.2",
    "vite": "^5.3.1"
  }
}
